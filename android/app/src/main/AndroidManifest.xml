<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Alarm plugin (com.gdelataillade.alarm) required permissions. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- 仕様 12.1：スヌーズ中だけ動く前景サービス（SnoozeService）。ロック解除を
         検知して常駐通知をヘッドアップで再掲し、解除ボタンを載せる。API 34+ は
         種別の宣言が必須で、この用途に合う既定の種別が無いため specialUse。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- Posting the oversleep share to a Discord webhook. The debug manifest
         has always declared this for the Flutter tool's own use, which is why
         it worked in development; without it here, the release build reaches
         nothing and every post fails as a connection error. It is the only
         network the app makes: Discord and the user's own SMTP server, and
         nowhere else. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 寝坊時の SMS（仕様 11.5）。本人の番号から相手に送る。実行時にも
         「SMS」トグルを ON にした時点で要求する。**本体のマニフェストに置く**：
         段階C で INTERNET がデバッグ用にしか無く、リリース版だけ壊れていた
         のと同じ事故を繰り返さないため。
         Google Play はこの権限をほぼ通さないので配布は sideload 前提。
         README の「既知の制約」に書いてある。 -->
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <!-- 寝坊時の電話発信（仕様 11.5）。ACTION_CALL で本人の番号から相手を
         鳴らす。音声は流さない。READ_PHONE_STATE は通話が始まった／終わった
         のを知るためだけに使う（通話中はアラーム音を止め、終わったら鳴らし
         直す）。番号や通話履歴は読まないし、どこにも送らない。
         どちらも「電話」トグルを ON にした瞬間に実行時要求する。 -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <application
        android:label="覚悟の目覚まし"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- launchMode は singleTask（段階F）。singleTop から変えたのは
             Discord のコールバックのため：`wakeorpay://` の VIEW intent が
             **この Activity 自身**に来て、既にあるインスタンスが載っている
             タスクごと前面に出る必要がある。singleTop だと、ブラウザの
             タスクから来た intent が MainActivity を**新しく**作り、
             Custom Tab の上に別のアプリの画面が生えることになる。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter 側のディープリンクは **切る**（段階F）。
                 これが既定の true のままだと、下の intent-filter を足した
                 瞬間にエンジンが `wakeorpay://discord/callback#access_token=…`
                 を **go_router のパス**として渡してしまい、アプリ全体が
                 「Page Not Found / no routes for location: wakeorpay://…」の
                 赤い画面に差し替わる（エミュレータで実際にそうなった）。
                 コールバックが要るのは app_links だけで、あちらは Intent を
                 直接読むのでこれを false にしても何も失わない。
                 このアプリはルーティングにディープリンクを使っていない。 -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Discord OAuth2 の戻り先（段階F）。Discord アプリまたは
                 ブラウザが `wakeorpay://discord/callback#access_token=…` を
                 投げてくる先。app_links がこの intent を Dart 側に流す。

                 **前は flutter_web_auth_2 の CallbackActivity が受けていて、
                 それがユーザーの言う「承認したのに何も起きない」の正体だった。**
                 あの Activity は `taskAffinity=""` で自前のタスクに落ちるので、
                 Dart の future は解決するのに、画面はブラウザの Custom Tab の
                 まま。アプリは後ろで「連携済み」になっているが、誰にも見えない。
                 ここに置けば、intent がアプリのタスクそのものを前に出す。

                 exported="true" は必須（別プロセスから来るため）。
                 掴むのは wakeorpay スキームだけで、https は掴まない。
                 autoVerify も不要：カスタムスキームに App Links の検証は無い。
                 このスキームを扱うコンポーネントは、アプリ全体でここ 1 つ。 -->
            <intent-filter android:label="Discord 連携">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wakeorpay" />
            </intent-filter>

            <!-- Discord OAuth2 の**本来の**戻り先（段階G）。
                 Discord はこのアプリの `wakeorpay://discord/callback` を
                 リダイレクト URI として受け付けない：認可画面の前に
                 「Redirect URI 'wakeorpay://discord/callback' is not supported
                 by client」で止まり、コールバックは永久に来ない。実機で確認済み。
                 そこでリダイレクト先は Worker の https URL にした。

                 autoVerify="true" が肝。Android が起動時／更新時に
                 https://wake-or-pay-discord.wakeorpay.workers.dev/
                 .well-known/assetlinks.json を取りに行き、そこに載っている
                 SHA-256 が実際の署名証明書と一致すれば、この URL は
                 **ブラウザを一切見せずに**このアプリに直接届く。
                 一致しなければブラウザが開き、Worker のページが
                 `wakeorpay://` に跳ね返す（上の intent-filter が受ける）。
                 つまり検証の成否は速さの差であって、成否の差ではない。

                 パスは 2 本ちょうどに限る。ホスト全体を掴むと Worker の
                 他のパス（assetlinks.json 自身も含む）までアプリに来てしまう。

                 **/discord/callback/return を足した理由（段階H）。**
                 実機（Pixel・既定ブラウザ Brave）では OS 側は全部正しかった：
                 `pm get-app-links` は verified、`pm query-activities` は
                 MainActivity を返す。それでも認証後にアプリが開かなかった。
                 Chromium は「リダイレクトの終着点として着いた」App Link を
                 アプリに渡さない——Discord のリダイレクトはまさにその形。
                 そこで着地ページから **新しいトップレベル遷移**として
                 この 2 本目のパスへ飛ぶ。同じパラメータ、別の扉。
                 検証はホスト単位なので、パスを足しても再検証の可否は変わらない。 -->
            <intent-filter android:autoVerify="true" android:label="Discord 連携">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="wake-or-pay-discord.wakeorpay.workers.dev"
                      android:path="/discord/callback" />
                <data android:scheme="https"
                      android:host="wake-or-pay-discord.wakeorpay.workers.dev"
                      android:path="/discord/callback/return" />
            </intent-filter>
        </activity>

        <!-- 仕様 12.1：スヌーズ中の常駐通知（解除アクション付き）を持つ前景サービス。
             ロック解除の検知は onCreate 内で registerReceiver する（マニフェスト
             宣言の USER_PRESENT は Android 8+ で発火しないため）。 -->
        <service
            android:name=".SnoozeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="snooze_dismiss" />
        </service>

        <!-- Warns the user when the app is killed while alarms are scheduled. -->
        <service android:name="com.gdelataillade.alarm.services.NotificationOnKillService" />

        <!-- 仕様 11.7：アプリが止まっていても寝坊の連絡を出すための
             android_alarm_manager_plus。パッケージ自身のマニフェストには
             何も入っていないので、ここで宣言する必要がある。 -->
        <service
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>
        <receiver
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmBroadcastReceiver"
            android:exported="false"/>
        <!-- 再起動後に予約を張り直すためのもの。プラグインが必要なときだけ
             有効にするので、ここでは enabled=false のままでよい。 -->
        <receiver
            android:name="dev.fluttercommunity.plus.androidalarmmanager.RebootBroadcastReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ hides other packages unless they are declared here.
             Without this flutter_tts cannot see any speech engine at all, and
             the oversleep contact countdown would be silent on a real device. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- 同じ理由（Android 11+ のパッケージ可視性）で、Discord の認可ページを
             開く先が見えるようにしておく。ここが 0 件だと url_launcher は
             「開ける先が無い」と答え、連携はボタンを押した瞬間に終わる。

             **Discord アプリ狙いの宣言は消した（段階G）。** 実機で測った結果：
             `pm query-activities -d https://discord.com/oauth2/authorize` は
             ブラウザしか返さない（`https://discord.com/channels/@me` は
             com.discord も返すので、Discord のフィルタはパスを列挙していて
             /oauth2/authorize を意図的に外している）。`discord://…` は
             どの形でも "No activities found"——Discord アプリは discord:
             スキームを一切登録していない。つまり認可画面をアプリ内で出す
             経路は存在せず、ブラウザが唯一の道。

             残すのはブラウザだけ。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
